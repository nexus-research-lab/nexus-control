CONTROL_ADDRESS=0.0.0.0:8020
DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_STDOUT=true
LOG_NO_COLOR=false
LOG_FILE_ENABLED=true
LOG_PATH=~/.nexus/control/logs/logger.log
LOG_ROTATE_DAILY=true
LOG_MAX_SIZE_MB=10
LOG_MAX_AGE_DAYS=7
LOG_MAX_BACKUPS=7
LOG_COMPRESS=true
# 留空时默认使用 ~/.nexus/control。
CONTROL_DATA_DIR=
CONTROL_DATABASE_DRIVER=sqlite
CONTROL_DATABASE_URL=
# PostgreSQL 示例：
# CONTROL_DATABASE_DRIVER=postgres
# CONTROL_DATABASE_URL=postgres://nexus_control:password@postgres:5432/nexus
CONTROL_WEB_AUTH_BASE=/auth/v1
CONTROL_SERVICE_TOKEN=
CONTROL_SERVICE_TOKEN_FILE=
# 可选的一次性建站 capability；配置时至少 32 个字符。
CONTROL_SETUP_TOKEN=
CONTROL_SIGNING_PRIVATE_KEY=
CONTROL_SIGNING_KEY_FILE=
CONTROL_SIGNING_PUBLIC_KEY_FILE=
CONTROL_SESSION_TTL_HOURS=24
AUTH_SESSION_COOKIE_NAME=nexus_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CONTROL_PRINCIPAL_TTL_SECONDS=60
CONTROL_PRINCIPAL_AUDIENCE=nexus-runtime
CONTROL_DEPLOYMENT_NAME=Nexus
AUTH_INIT_OWNER_USERNAME=admin
AUTH_INIT_OWNER_DISPLAY_NAME=Admin
AUTH_INIT_OWNER_PASSWORD=
